# Base de datos (SQLite local; Postgres en AWS: postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./agrotracker.db

# CORS: origen del frontend
FRONTEND_URL=http://localhost:8501

# Fase 2: API privada Instacrops (pendiente contrato)
INSTACROPS_API_URL=https://api.instacrops.com
INSTACROPS_API_KEY=

# Fase 2: IA para recomendaciones (simulado | claude)
IA_PROVEEDOR=simulado
IA_MODELO=claude-opus-5-5
ANTHROPIC_API_KEY=

# Reportes por correo (simulado | smtp). Con Gmail usar una "contraseña de aplicación".
CORREO_PROVEEDOR=simulado
CORREO_REMITENTE=AgroTracker <no-reply@agrotracker.cl>
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
