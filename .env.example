# Base de datos (SQLite local; Postgres en AWS: postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./agrotracker.db

# Autenticación. SECRET_KEY firma los tokens (generar con: python -c "import secrets; print(secrets.token_urlsafe(32))").
# ADMIN_*: se crea este administrador al iniciar si aún no hay usuarios. ADMIN_CLAVE debe tener
# al menos 12 caracteres y no se versiona: complétala solo en tu .env.
SECRET_KEY=
TOKEN_MINUTOS=480
ADMIN_NOMBRE=Directiva Newen al Sur
ADMIN_EMAIL=admin@newenalsur.cl
ADMIN_CLAVE=

# CORS: origen del frontend
FRONTEND_URL=http://localhost:8501

# Fase 2: sensores del campo (ninguno | instacrops). Aún sin contrato con Instacrops: para probar,
# levantar simuladores/ (ver README) y usar INSTACROPS_API_URL=http://127.0.0.1:9000/instacrops y clave demo.
SENSORES_PROVEEDOR=ninguno
INSTACROPS_API_URL=https://api.instacrops.com
INSTACROPS_API_KEY=
INSTACROPS_CACHE_MINUTOS=5

# 1 si Agromet e Instacrops apuntan a simuladores/: la app muestra que los datos son de ejemplo.
APIS_SIMULADAS=0

# Fase 2: clima del campo (simulado | agromet). Agromet = Red Agroclimática Nacional (agromet.cl):
# se usa la estación más cercana al campo. El endpoint no es una API pública documentada y hoy su
# firewall bloquea clientes automáticos: pedir acceso a info@agromet.cl antes de usar "agromet".
CLIMA_PROVEEDOR=simulado
AGROMET_URL=https://www.agromet.cl/ext/aux/getGraphData.php
AGROMET_CACHE_MINUTOS=15

# Fase 2: IA para recomendaciones (simulado | gemini | claude)
IA_PROVEEDOR=simulado
# 0 desactiva las recomendaciones (interruptor ante sugerencias erróneas, LA-G10-05)
IA_HABILITADA=1
# Recomendaciones por usuario al día (0 = sin límite). Controla el gasto en la API.
IA_LIMITE_DIARIO=20
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
IA_MODELO=claude-opus-5-5
ANTHROPIC_API_KEY=

# Reportes por correo (simulado | smtp). Con Gmail usar una "contraseña de aplicación".
CORREO_PROVEEDOR=simulado
CORREO_REMITENTE=AgroTracker <no-reply@agrotracker.cl>
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
