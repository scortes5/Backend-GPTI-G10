# Copiar a despliegue/.env y completar. Este archivo no se versiona.
# Generar claves con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Dominio público (sin https://). Su DNS debe apuntar a este servidor para que Caddy obtenga el
# certificado. Para probar en el computador: localhost
DOMINIO=localhost

POSTGRES_PASSWORD=
SECRET_KEY=
FLASK_SECRET_KEY=

# Primer administrador (se crea si la base está vacía). ADMIN_CLAVE: mínimo 12 caracteres.
ADMIN_NOMBRE=Directiva Newen al Sur
ADMIN_EMAIL=admin@newenalsur.cl
ADMIN_CLAVE=

# simulado | agromet  (agromet requiere que la red autorice el acceso: info@agromet.cl)
CLIMA_PROVEEDOR=simulado

# simulado | claude
IA_PROVEEDOR=simulado
ANTHROPIC_API_KEY=

# simulado | smtp  (Brevo: smtp-relay.brevo.com, puerto 587)
CORREO_PROVEEDOR=simulado
CORREO_REMITENTE=AgroTracker <no-reply@agrotracker.cl>
SMTP_USUARIO=
SMTP_CLAVE=

# Si el frontend no está clonado en ../../Frontend-GPTI-G10
# FRONTEND_DIR=/ruta/al/Frontend-GPTI-G10
